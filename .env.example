# ============================================================
# SYS — Environment Configuration Template
# ============================================================
# Copy to backend/.env for local backend development:
#   copy .env.example backend\.env
#
# Optional repo-root .env is also loaded.
# For Next.js public config, use frontend/.env.local when needed.
#
# NEVER commit .env, .env.local, or real credentials.
# ============================================================


# ------------------------------------------------------------
# Database (REQUIRED)
# ------------------------------------------------------------
# Used by SQLAlchemy (app.config → database.py) and Alembic (alembic/env.py).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# REQUIRED when running backend tests. The SQLite sentinel is materialized as
# a unique disposable file so threaded tests share one isolated database.
# A PostgreSQL alternative must use a database whose name contains "test".
TEST_DATABASE_URL=sqlite://


# ------------------------------------------------------------
# Authentication / Security (REQUIRED)
# ------------------------------------------------------------
# Generate a strong random value. Do not use CHANGE_ME in production.
SECRET_KEY=CHANGE_ME

# JWT access-token lifetime in minutes (optional; default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ------------------------------------------------------------
# Frontend (optional — Next.js / browser)
# ------------------------------------------------------------
# Used by frontend/src/api.js (Axios baseURL).
# Must use NEXT_PUBLIC_ so Next.js exposes it to the browser bundle.
# Place in frontend/.env.local (or repo-root .env.local when supported).
# Default fallback in code if unset: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000


# ------------------------------------------------------------
# Email / Notifications (optional — P0-009)
# ------------------------------------------------------------
# If unset, notification records are created but delivery is marked FAILED
# without affecting assessment result persistence.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
