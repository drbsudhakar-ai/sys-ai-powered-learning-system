# ============================================================
# SYS — Environment Configuration Template
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env or real credentials to Git.
# P0-001 will reconcile these variables with the actual codebase.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=SYS
APP_ENV=development
DEBUG=true

# Backend
HOST=127.0.0.1
PORT=8000

# API
API_V1_PREFIX=/api/v1


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# PostgreSQL is the intended production database.
#
# Example:
# DATABASE_URL=postgresql+psycopg://sys_user:password@localhost:5432/sys
DATABASE_URL=


# ------------------------------------------------------------
# Authentication / Security
# ------------------------------------------------------------
# Generate strong random values.
# NEVER use these example values in production.

SECRET_KEY=
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Local frontend
CORS_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# Backend API URL used by Next.js frontend

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1


# ------------------------------------------------------------
# AI Provider
# ------------------------------------------------------------
# Keep AI provider configuration provider-neutral.
# Do not commit real API keys.

AI_PROVIDER=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model names
OPENAI_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=


# ------------------------------------------------------------
# File / Resource Storage
# ------------------------------------------------------------
# Development can initially use local storage.
# Production storage will be finalized during implementation.

STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./storage


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Email / Notifications
# ------------------------------------------------------------
# Keep empty until SYS notification/email requirements
# are implemented.

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=


# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
# Optional separate test database.

TEST_DATABASE_URL=